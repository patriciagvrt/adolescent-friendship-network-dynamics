# Build a sex vector aligned to the SAOM node order
sex_col_V_saom <- get_first_existing(classV_saom, c("sex", "sexc", "sexd"))
sex_col_X_saom <- get_first_existing(classX_saom, c("sexc", "sex", "sexd"))
sex_col_Y_saom <- get_first_existing(classY_saom, c("sexd", "sex", "sexc"))
sex_saom_num <- dplyr::coalesce(
as.numeric(classV_saom[[sex_col_V_saom]]),
as.numeric(classX_saom[[sex_col_X_saom]]),
as.numeric(classY_saom[[sex_col_Y_saom]])
)
share_same_sex <- function(A, sex_vec) {
same <- outer(sex_vec, sex_vec, FUN = "==")
diag(same) <- NA
ties <- (A > 0)
num <- sum(ties & same, na.rm = TRUE)
den <- sum(ties, na.rm = TRUE)
if (den == 0) return(NA_real_)
num / den
}
same_sex_tbl <- tibble(
Wave = c("Wave V", "Wave X", "Wave Y"),
Share_same_sex = c(
share_same_sex(netV_saom, sex_saom_num),
share_same_sex(netX_saom, sex_saom_num),
share_same_sex(netY_saom, sex_saom_num)
)
)
knitr::kable(same_sex_tbl, digits = 3)
