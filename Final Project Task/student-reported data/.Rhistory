library(RSiena)
# supondo que seu ajuste final esteja em: ans
# e o nome da sua rede no sienaData esteja em varName, ex: "friendship"
gof.triad <- sienaGOF(ans, TriadCensus, varName = "friendship",
join = TRUE, verbose = TRUE, nsim = 1000)
#| label: inspect-gof-triad
#| echo: true
str(gof_triad_m2, max.level = 2)
names(gof_triad_m2)
#| label: triad-misfit-table
#| echo: true
g <- gof_triad_m2$Joint
triad <- attr(g, "key")                 # "003" "012" ... "300"
obs   <- as.numeric(g$Observations[1,]) # 16 valores observados
sim   <- g$Simulations                  # 250 x 16
# Coloca nomes nas colunas das simulações (facilita tudo)
colnames(sim) <- triad
sim_mean <- colMeans(sim)
sim_sd   <- apply(sim, 2, sd)
sim_lo   <- apply(sim, 2, quantile, 0.025)
sim_hi   <- apply(sim, 2, quantile, 0.975)
z <- (obs - sim_mean) / sim_sd
z[sim_sd == 0] <- NA  # segurança (se alguma tríade nunca variar nas simulações)
gof_triad_table <- data.frame(
triad    = triad,
obs      = obs,
sim_mean = as.numeric(sim_mean),
lo_2.5   = as.numeric(sim_lo),
hi_97.5  = as.numeric(sim_hi),
z        = as.numeric(z),
outside  = (obs < sim_lo) | (obs > sim_hi)
)
# Top 10 discrepâncias (maior |z|)
gof_triad_table[order(-abs(gof_triad_table$z)), ][1:10, ]
subset(gof_triad_table, outside)
gof_triad_table$diff <- gof_triad_table$obs - gof_triad_table$sim_mean
gof_triad_table[order(-abs(gof_triad_table$diff)), ][1:10, ]
# 1) Modelo novo (exemplo com cycle3)
eff_m3 <- eff_m2
eff_m3 <- includeEffects(eff_m3, cycle3)
res_m3 <- siena07(alg = alg, data = siena_dat, effects = eff_m3,
prevAns = res_m2, batch = TRUE, silent = TRUE)
#| label: estimate-model3
# cria Modelo 3 a partir do Modelo 2
