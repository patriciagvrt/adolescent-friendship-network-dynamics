#| echo: false
#| message: false
#| warning: false
#| fig-width: 7
#| fig-height: 4.6
#| 
plot(gof_outdeg_m1)

```

```{r}
#| label: fig-gof-triad-m1
#| fig-cap: "Goodness-of-fit for the triad census (Model 1)."
#| echo: false
#| results: hide
#| message: false
#| warning: false
#| fig-width: 10
#| fig-height: 4.2

op <- par(las = 2, mar = c(8, 4, 2, 1), cex.axis = 0.75)
plot(gof_triad_m1, center = TRUE, scale = TRUE, fontsize = 6)
par(op)
```

```{r}
#| label: tbl-gof-pvalues-m1
#| tbl-cap: "GoF Monte Carlo p-values for Model 1."
#| echo: false
#| results: asis
#| message: false
#| warning: false

gof_p_m1 <- tibble(
  Statistic = c("Indegree distribution", "Outdegree distribution", "Triad census"),
  P_value   = c(get_p(gof_indeg_m1), get_p(gof_outdeg_m1), get_p(gof_triad_m1))
)

knitr::kable(gof_p_m1, digits = 3)
```


```{r}
#| label: gof-model2
#| echo: false
#| results: hide
#| message: false
#| warning: false

# Update: add reciAct (reciprocated degree activity)
eff_m2 <- eff_m1
eff_m2 <- includeEffects(eff_m2, reciAct)

# Estimate updated model starting from Model 1 solution
alg_m2 <- sienaAlgorithmCreate(projname = "bestfriends_saom_VXY_m2", seed = 12345, n3 = 4000)
res_m2 <- siena07(
  alg_m2,
  data = siena_dat,
  effects = eff_m2,
  prevAns = res_final,
  batch = TRUE,
  silent = TRUE
)

# Simulate for GoF under Model 2
sims_m2 <- siena07(
  gof_alg,
  data = siena_dat,
  effects = eff_m2,
  prevAns = res_m2,
  returnDeps = TRUE,
  batch = TRUE,
  silent = TRUE
)

gof_indeg_m2 <- sienaGOF(sims_m2, varName = dep_name,
                         IndegreeDistribution, cumulative = FALSE, levls = levs)

gof_outdeg_m2 <- sienaGOF(sims_m2, varName = dep_name,
                          OutdegreeDistribution, cumulative = FALSE, levls = levs)

gof_triad_m2 <- sienaGOF(sims_m2, varName = dep_name,
                         TriadCensus, verbose = TRUE)


```


```{r}

#| label: fig-gof-triad-m2
#| fig-cap: "Goodness-of-fit for the triad census after the model update (Model 2)."
#| echo: false
#| results: hide
#| message: false
#| warning: false
#| fig-width: 10
#| fig-height: 4.2

op <- par(las = 2, mar = c(8, 4, 2, 1), cex.axis = 0.75)
plot(gof_triad_m2, center = TRUE, scale = TRUE, fontsize = 6)
par(op)

```

```{r}
#| label: tbl-gof-compare
#| tbl-cap: "Comparison of GoF Monte Carlo p-values (Model 1 vs. Model 2)."
#| echo: false
#| results: asis
#| message: false
#| warning: false

gof_compare <- tibble(
  Statistic = c("Indegree distribution", "Outdegree distribution", "Triad census"),
  P_Model1  = c(get_p(gof_indeg_m1), get_p(gof_outdeg_m1), get_p(gof_triad_m1)),
  P_Model2  = c(get_p(gof_indeg_m2), get_p(gof_outdeg_m2), get_p(gof_triad_m2))
)

knitr::kable(gof_compare, digits = 3)


```


## 10. Discussion and Limits



<!--
ORIGINAL (draft in v8):
> We interpret the converged SAOM estimates from Model 1 (three waves; constant node set). Convergence was achieved (overall maximum convergence ratio = 0.1221, with small parameter-wise convergence t-ratios), so the parameter estimates can be interpreted.
In SAOMs, positive parameter estimates indicate that a mechanism increases the attractiveness of creating/maintaining a tie, whereas negative estimates indicate that a mechanism discourages tie formation/maintenance, conditional on the other effects in the model.
**Baseline network tendencies.** The density (outdegree) parameter is negative (Estimate = -0.108, SE = 0.390), consistent with a sparse directed nomination network. Reciprocity is strongly positive (Estimate = 1.641, SE = 0.205; t ≈ 7.99), indicating that best-friend nominations are frequently mutual.
**H1 (Dyadic): Sex homophily.** The same-sex effect (sameX with sex_cov) is positive (Estimate = 0.266, SE = 0.112; t ≈ 2.39). This supports the hypothesis that pupils are more likely to nominate same-sex classmates as best friends, controlling for other network tendencies.:contentReference[oaicite:6]{index=6}
**H2 (Triadic): Transitivity.** The transitive triplets effect is positive and highly statistically meaningful (Estimate = 0.350, SE = 0.038; t ≈ 9.16). This provides strong evidence for triadic closure: best-friend ties tend to form in ways that close transitive structures (“friends of friends become friends”).
**H3 (Node-level): Popularity reinforcement.** Contrary to our expectation, indegree popularity (inPop) is negative and statistically meaningful (Estimate = -0.376, SE = 0.079; t ≈ -4.76). This does not support a Matthew-effect interpretation in this classroom; instead, conditional on reciprocity and transitivity, pupils appear less likely to nominate classmates who already receive many nominations.:contentReference[oaicite:9]{index=9}
