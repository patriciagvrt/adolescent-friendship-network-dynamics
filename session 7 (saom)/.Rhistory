#| label: gof-setup
#| echo: false
#| results: hide
#| message: false
#| warning: false
library(RSiena)
library(tibble)
library(knitr)
# Dependent network name inside siena_dat:
# In our workflow, the dependent object was named "friendship_saom".
dep_name <- "friendship_saom"
# Simulation settings for GoF:
# nsub = 0 skips estimation; n3 = number of simulated datasets for GoF.
gof_alg <- sienaAlgorithmCreate(n3 = 250, nsub = 0, seed = 12345)
# Simulate from Model 1 (use estimates from res_final)
sims_m1 <- siena07(
gof_alg,
data = siena_dat,
effects = eff_m1,
prevAns = res_final,
returnDeps = TRUE,
batch = TRUE,
silent = TRUE
)
max_deg <- min(15, nrow(netV_saom) - 1)
levs <- 0:max_deg
# GoF objects (Model 1)
gof_indeg_m1 <- sienaGOF(sims_m1, varName = dep_name,
IndegreeDistribution, cumulative = FALSE, levls = levs)
gof_outdeg_m1 <- sienaGOF(sims_m1, varName = dep_name,
OutdegreeDistribution, cumulative = FALSE, levls = levs)
gof_triad_m1 <- sienaGOF(sims_m1, varName = dep_name,
TriadCensus, verbose = TRUE)
# helper to extract p-values robustly
get_p <- function(g) {
for (nm in c("p", "pvalue", "p.value", "pval", "pValue")) {
if (!is.null(g[[nm]])) return(as.numeric(g[[nm]]))
}
NA_real_
}
#| label: fig-gof-model1-panel
#| fig-cap: "Goodness-of-fit diagnostics for Model 1 (indegree distribution, outdegree distribution, and triad census)."
#| echo: false
#| message: false
#| warning: false
#| layout: [[1, 1], [2, 3]]
#| fig-width: 8
#| fig-height: 6
plot(gof_indeg_m1)
plot(gof_outdeg_m1)
plot(gof_triad_m1, center = TRUE, scale = TRUE)
#| label: fig-gof-triad-m1
#| fig-cap: "Goodness-of-fit for the triad census (Model 1)."
#| echo: false
#| results: hide
#| message: false
#| warning: false
#| fig-width: 10
#| fig-height: 4.2
op <- par(las = 2, mar = c(8, 4, 2, 1), cex.axis = 0.75)
plot(gof_triad_m1, center = TRUE, scale = TRUE, fontsize = 6)
par(op)
