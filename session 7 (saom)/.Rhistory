# Name of the dependent network inside the RSiena data object
dep_name <- tryCatch(names(siena_dat$depvars)[1], error = function(e) "friendship_saom")
# Simulation settings for GoF (phase 2 skipped; simulate end-of-period networks)
gof_alg <- sienaAlgorithmCreate(n3 = 250, nsub = 0, seed = 12345)
sims_m1 <- siena07(
gof_alg,
data = siena_dat,
effects = eff_m1,
prevAns = res_final,
returnDeps = TRUE,
batch = TRUE,
silent = TRUE
)
