knitr::kable(sexV[1:5, 1:5], caption = "Sex similarity matrix (Wave V; 5×5 subset)")
knitr::kable(sexX[1:5, 1:5], caption = "Sex similarity matrix (Wave X; 5×5 subset)")
knitr::kable(sexY[1:5, 1:5], caption = "Sex similarity matrix (Wave Y; 5×5 subset)")
library(igraph)
# Create graphs from adjacency matrices (if not already done)
gV <- graph_from_adjacency_matrix(netV, mode = "directed")
gX <- graph_from_adjacency_matrix(netX, mode = "directed")
gY <- graph_from_adjacency_matrix(netY, mode = "directed")
# Compute global transitivity (triadic closure) for each wave
trans_V <- transitivity(gV, type = "global")
trans_X <- transitivity(gX, type = "global")
trans_Y <- transitivity(gY, type = "global")
# Combine into a table
trans_table <- data.frame(
Wave = c("Wave V", "Wave X", "Wave Y"),
Transitivity = round(c(trans_V, trans_X, trans_Y), 3)
)
knitr::kable(trans_table, caption = "Global transitivity by wave")
# Popularity (here: indegree = number of nominations received)
calc_pop_df <- function(adj, wave_label) {
tibble(
StudentID = as.numeric(colnames(adj)),
Wave = wave_label,
Popularity = as.numeric(colSums(adj, na.rm = TRUE))
)
}
pop_df <- bind_rows(
calc_pop_df(netV, "Wave V"),
calc_pop_df(netX, "Wave X"),
calc_pop_df(netY, "Wave Y")
)
pop_summary <- pop_df |>
group_by(Wave) |>
summarise(
MeanPopularity = mean(Popularity),
MinPopularity = min(Popularity),
MaxPopularity = max(Popularity),
.groups = "drop"
)
knitr::kable(pop_summary, digits = 2, caption = "Popularity (indegree) summary by wave")
ggplot(pop_summary, aes(x = Wave, y = MeanPopularity)) +
geom_col() +
geom_text(aes(label = round(MeanPopularity, 2)), vjust = -0.5) +
ylim(0, max(pop_summary$MeanPopularity) + 1) +
labs(title = "Mean popularity across waves", y = "Mean indegree", x = NULL) +
theme_minimal()
# Create a data frame of control variables
control_vars <- data.frame(
Variable = c("Sex (ego)", "Popularity (alter)", "Sex similarity (dyad)",
"Transitivity (structural)", "Reciprocity (structural)"),
Type = c("Ego-level", "Alter-level", "Dyadic", "Structural", "Structural"),
Description = c(
"Sex of the student sending the nomination, to account for homophily.",
"Number of nominations received by the student, capturing preference for popular peers.",
"1 if both students share the same sex, 0 otherwise; captures dyadic homophily.",
"Tendency for friends of friends to become friends; accounts for clustering in the network.",
"Tendency for a friendship nomination to be reciprocated; captures mutual connections."
)
)
# Print the table
knitr::kable(control_vars, caption = "Control variables to be included in the analysis")
#| label: fig-bestfriends-waveV
