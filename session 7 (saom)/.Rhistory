#| label: siena-model-estimation
#| echo: false
#| results: hide
#| message: false
#| warning: false
library(RSiena)
library(dplyr)
# --- 1) Dependent network (3 waves) ---
friendship_saom <- sienaDependent(
array(c(netV_saom, netX_saom, netY_saom),
dim = c(nrow(netV_saom), ncol(netV_saom), 3))
)
# --- 2) Constant actor covariate: sex ---
sex_saom_num <- dplyr::coalesce(classV_saom$sex, classX_saom$sexc, classY_saom$sexd) |> as.numeric()
sex_cov <- coCovar(sex_saom_num)
# --- 3) RSiena data object ---
siena_dat <- sienaDataCreate(friendship_saom, sex_cov)
# --- 4) Effects: defaults + hypotheses + control ---
eff_m1 <- getEffects(siena_dat)
# Hypotheses
eff_m1 <- includeEffects(eff_m1, transTrip)                     # transitivity (triadic closure)
eff_m1 <- includeEffects(eff_m1, sameX, interaction1="sex_cov") # sex homophily
eff_m1 <- includeEffects(eff_m1, inPop)                         # indegree popularity (Matthew effect)
# Basic control for sender heterogeneity
eff_m1 <- includeEffects(eff_m1, outAct)
# Convergence checker (RSiena rule of thumb)
is_converged <- function(res) {
ok_tmax  <- !is.null(res$tconv.max) && is.finite(res$tconv.max) && res$tconv.max < 0.25
ok_allt  <- !is.null(res$tconv) && all(abs(res$tconv) < 0.10, na.rm = TRUE)
ok_tmax && ok_allt
}
# --- 5) Estimation loop: continue until convergence ---
attempt_log <- list()
# Attempt 1 (baseline effort)
alg1 <- sienaAlgorithmCreate(projname = "bestfriends_saom_VXY", seed = 12345)
res1 <- siena07(alg1, data = siena_dat, effects = eff_m1, batch = TRUE, silent = TRUE)
attempt_log[[1]] <- list(model = "Model 1 (initial)", res = res1)
# Attempt 2 (more effort, start from previous answer) if needed
if (!is_converged(res1)) {
alg2 <- sienaAlgorithmCreate(projname = "bestfriends_saom_VXY", seed = 12345, n3 = 4000)
res2 <- siena07(alg2, data = siena_dat, effects = eff_m1, prevAns = res1,
batch = TRUE, silent = TRUE)
attempt_log[[2]] <- list(model = "Model 1 (continued)", res = res2)
} else {
res2 <- res1
}
# Attempt 3 (even more effort) if still needed
if (!is_converged(res2)) {
alg3 <- sienaAlgorithmCreate(projname = "bestfriends_saom_VXY", seed = 12345, n3 = 8000)
res3 <- siena07(alg3, data = siena_dat, effects = eff_m1, prevAns = res2,
batch = TRUE, silent = TRUE)
attempt_log[[3]] <- list(model = "Model 1 (continued, higher n3)", res = res3)
} else {
res3 <- res2
}
# Optional model modification if still not converged:
# remove outAct (non-essential control) to reduce complexity while keeping hypotheses.
if (!is_converged(res3)) {
eff_m2 <- getEffects(siena_dat)
eff_m2 <- includeEffects(eff_m2, transTrip)
eff_m2 <- includeEffects(eff_m2, sameX, interaction1="sex_cov")
eff_m2 <- includeEffects(eff_m2, inPop)
alg4 <- sienaAlgorithmCreate(projname = "bestfriends_saom_VXY", seed = 12345, n3 = 8000)
res4 <- siena07(alg4, data = siena_dat, effects = eff_m2, prevAns = res3,
batch = TRUE, silent = TRUE)
attempt_log[[4]] <- list(model = "Model 1 (modified: drop outAct)", res = res4)
res_final <- res4
} else {
res_final <- res3
}
#| label: tbl-siena-results
#| tbl-cap: "RSiena parameter estimates for the final converged model."
#| echo: false
#| results: asis
#| message: false
#| warning: false
library(tibble)
library(dplyr)
library(knitr)
s <- summary(res_final)
# Most RSiena outputs store the main results table in summary(res)$effects (matrix/data.frame)
if (!is.null(s$effects)) {
res_tbl <- as.data.frame(s$effects) |>
rownames_to_column(var = "Effect")
} else if (!is.null(res_final$theta) && !is.null(res_final$se)) {
est <- as.numeric(res_final$theta)
se  <- as.numeric(res_final$se)
res_tbl <- tibble(
Effect   = names(res_final$theta),
Estimate = est,
SE       = se,
t_ratio  = est / se
)
} else {
res_tbl <- tibble(
Note = "Could not automatically extract the results table. Please run summary(res_final) and share the output."
)
}
knitr::kable(res_tbl, digits = 3)
#| label: tbl-siena-results
#| echo: false
#| results: asis
#| message: false
#| warning: false
library(xtable)
tab <- xtable::xtable(
res_final,
caption = "RSiena parameter estimates for the final converged model.",
label = "tbl:siena-results"
)
#| label: tbl-siena-results
#| tbl-cap: "RSiena parameter estimates for the final model."
#| echo: false
#| results: asis
#| message: false
#| warning: false
library(tibble)
library(knitr)
est <- as.numeric(res_final$theta)
se  <- as.numeric(res_final$se)
effect_names <- names(res_final$theta)
if (is.null(effect_names) || all(effect_names == "")) {
# fallback: try rownames from the summary table
effect_names <- rownames(summary(res_final)$effects)
}
res_tbl <- tibble(
Effect   = effect_names,
Estimate = est,
SE       = se,
t_ratio  = est / se
)
knitr::kable(res_tbl, digits = 3)
