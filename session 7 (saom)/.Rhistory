library(tidyverse)
library(igraph)
library(ggraph)
# Build graphs from SAOM-aligned matrices (same node set across waves)
gV_saom <- graph_from_adjacency_matrix(netV_saom, mode = "directed", diag = FALSE)
gX_saom <- graph_from_adjacency_matrix(netX_saom, mode = "directed", diag = FALSE)
gY_saom <- graph_from_adjacency_matrix(netY_saom, mode = "directed", diag = FALSE)
# Sex attribute: use Wave V as baseline (SAOM-aligned ordering)
sex_num <- as.numeric(classV_saom$sex)
sex_fac <- factor(sex_num, levels = c(1, 2), labels = c("Female", "Male"))
V(gV_saom)$sex <- sex_fac
V(gX_saom)$sex <- sex_fac
V(gY_saom)$sex <- sex_fac
# Fixed layout from an aggregated (undirected) version of the network
adj_agg <- ((netV_saom + netX_saom + netY_saom) > 0) * 1
g_agg <- graph_from_adjacency_matrix(adj_agg, mode = "undirected", diag = FALSE)
set.seed(12345)
xy <- layout_with_fr(g_agg)
plot_one <- function(g, xy) {
ggraph(g, layout = "manual", x = xy[, 1], y = xy[, 2]) +
geom_edge_link(alpha = 0.35) +
geom_node_point(aes(color = sex), size = 3) +
labs(color = "Sex") +
theme_void()
}
plot_one(gV_saom, xy)
