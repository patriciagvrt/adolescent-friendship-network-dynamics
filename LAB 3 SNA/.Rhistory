knitr::opts_chunk$set(message = FALSE, warning = FALSE)
library(network)
library(sna)
library(latticeExtra)
library(ergm)
library(statnet)
library(knitr)
library(igraph)
library(dplyr)
library(tidyr)
library(data.table) # data handling
library(gridExtra)
load("~/GitHub/Lab-assignments---Social-Network-Analysis/LAB 3 SNA/PairB.RData")
#| echo: false
# check and fitting the gender
gender <- student_vars$boy
length(gender)
table(gender, useNA = "ifany")
gender_lab <- factor(ifelse(gender == 1, "boy", "girl"))
table(gender_lab)
ls()
calc_net_stats <- function(adj, gender_vec){
adj <- as.matrix(adj)
diag(adj) <- 0
adj[is.na(adj)] <- 0
g <- igraph::graph_from_adjacency_matrix(adj, mode = "directed", diag = FALSE)
dens  <- igraph::edge_density(g, loops = FALSE)
recip <- igraph::reciprocity(g)
trans <- igraph::transitivity(g, type = "global")
if (is.nan(trans)) trans <- NA_real_
gender_f <- as.factor(gender_vec)
igraph::V(g)$gender <- gender_f
gender_codes <- as.integer(igraph::V(g)$gender)
homoph <- igraph::assortativity_nominal(g, types = gender_codes, directed = TRUE)
hier <- igraph::centr_degree(g, mode = "in", normalized = TRUE)$centralization
c(
density = dens,
reciprocity = recip,
transitivity = trans,
gender_homophily = homoph,
indegree_centralization = hier
)
}
nets <- list(
friendship  = friends,
liking      = liking,
popularity  = popular
)
results <- lapply(nets, calc_net_stats, gender_vec = gender) |>
dplyr::bind_rows(.id = "network")
results
#| label: tbl-network-comparison
#| tbl-cap: "Comparison of network properties across the three directed nomination networks."
#| echo: false
results_fmt <- results |>
mutate(across(where(is.numeric), ~ round(.x, 3)))
knitr::kable(results_fmt, booktabs = TRUE,
col.names = c("Network", "Density", "Reciprocity", "Transitivity",
"Gender homophily", "Indegree centralization"))
# 1) network objects
friendnet <- network(friends,  directed = TRUE, matrix.type = "adjacency")
likenet   <- network(liking,   directed = TRUE, matrix.type = "adjacency")
popnet    <- network(popular,  directed = TRUE, matrix.type = "adjacency")
# 2) gender attribute
gender_clean <- as.character(gender_lab)
friendnet %v% "gender" <- gender_clean
likenet   %v% "gender" <- gender_clean
popnet    %v% "gender" <- gender_clean
# 3) model RHS (required specification)
rhs <- ~ edges + mutual + nodematch("gender") +
gwesp(0.7, fixed = TRUE) + twopath + gwidegree(0.7, fixed = TRUE)
# 4) control (use Stochastic Approximation)
ctrl <- control.ergm(
main.method = "Stochastic-Approximation",
SA.initial_gain = 0.05,
SA.burnin = 2000,
seed = 123
)
# 5) fit models
m_friend <- ergm(update(friendnet ~ 1, rhs), control = ctrl)
m_like   <- ergm(update(likenet   ~ 1, rhs), control = ctrl)
m_pop    <- ergm(update(popnet    ~ 1, rhs), control = ctrl)
#  smaller decay for gwidegree
rhs_like03 <- ~ edges + mutual + nodematch("gender") +
gwesp(0.7, fixed = TRUE) + twopath + gwidegree(0.3, fixed = TRUE)
m_like03 <- try(ergm(update(likenet ~ 1, rhs_like03), control = ctrl), silent = TRUE)
if (!inherits(m_like03, "try-error")) {
m_like <- m_like03
}
# 6) extract coefs safely, and fix mutual in popularity  -Inf
extract_cells <- function(m, model_name){
co <- as.matrix(summary(m)$coefficients)
est <- co[, "Estimate"]
se  <- co[, "Std. Error"]
cell <- ifelse(
is.infinite(est) | abs(est) > 1e6,
"fixed at -Inf",
sprintf("%.3f (%.3f)", est, se)
)
tibble(
term  = rownames(co),
model = model_name,
cell  = cell
)
}
tbl_q6 <- bind_rows(
extract_cells(m_friend, "Friendship"),
extract_cells(m_like,   "Liking"),
extract_cells(m_pop,    "Popularity")
) %>%
mutate(Term = case_when(
term == "edges" ~ "Edges",
term == "mutual" ~ "Mutual",
term == "nodematch.gender" ~ "Gender homophily (nodematch)",
grepl("^gwesp", term) ~ "Transitive closure (GWESP 0.7)",
term == "twopath" ~ "Two-path",
grepl("^gwideg|^gwidegree", term) ~ "Preferential attachment (GW indegree 0.7)",
TRUE ~ term
)) %>%
select(Term, model, cell) %>%
pivot_wider(names_from = model, values_from = cell) %>%
slice(match(
c("Edges","Mutual","Gender homophily (nodematch)","Transitive closure (GWESP 0.7)","Two-path","Preferential attachment (GW indegree 0.7)"),
Term
))
#| label: tbl-ergm-comparison
#| tbl-cap: "ERGM results for friendship, liking, and popularity networks. Entries show estimate (SE). Models were estimated using stochastic approximation due to degeneracy issues in MPLE or MCMLE."
#| echo: false
knitr::kable(tbl_q6, booktabs = TRUE)
#| label: q9-gof-compute
#| include: false
#| message: false
#| warning: false
set.seed(888)
gof_friend <- gof(m_friend, control = control.gof.ergm(seed = 888, nsim = 200))
gof_like   <- gof(m_like,   control = control.gof.ergm(seed = 888, nsim = 200))
gof_pop    <- gof(m_pop,    control = control.gof.ergm(seed = 888, nsim = 200))
#| label: fig-gof-friend
#| fig-cap: "Goodness-of-fit diagnostics for the friendship ERGM."
#| fig-subcap:
#|   - "In-model terms (rank of observed statistics among simulations)."
#|   - "Outdegree distribution."
#|   - "Indegree distribution."
#|   - "Edgewise shared partners."
#|   - "Minimum geodesic distance (including unreachable dyads)."
#| layout-ncol: 2
#| echo: false
#| message: false
#| warning: false
#| fig-width: 6.5
#| fig-height: 4.5
plot(gof_friend)
#| label: q10-fit-friendship-edgecov
#| include: false
#| message: false
#| warning: false
# network object (friendship) + atributo de gênero
friendnet <- network(friends, directed = TRUE, matrix.type = "adjacency")
friendnet %v% "gender" <- as.character(gender_lab)
# garantir matrizes 0,1 e sem NA
L <- as.matrix(liking);  diag(L) <- 0; L[is.na(L)] <- 0
P <- as.matrix(popular); diag(P) <- 0; P[is.na(P)] <- 0
# modelo base + efeitos exógenos (edgecov)
mod_friend_edgecov <- friendnet ~
edges +
mutual +
nodematch("gender") +
gwesp(0.7, fixed = TRUE) +
twopath +
gwidegree(0.7, fixed = TRUE) +
edgecov(L) +
edgecov(P)
# controle, friendship costuma rodar bem, mas deixo SA para estabilidade
ctrl10 <- control.ergm(
main.method = "Stochastic-Approximation",
SA.initial_gain = 0.05,
seed = 123
)
m_friend_edgecov <- ergm(mod_friend_edgecov, control = ctrl10)
#| label: tbl-q10-friendship-edgecov
#| tbl-cap: "Friendship ERGM with edgecov effects of liking (acceptance) and popularity nominations. Entries show estimate (SE)."
#| echo: false
#| message: false
#| warning: false
co10 <- as.matrix(summary(m_friend_edgecov)$coefficients)
out10 <- dplyr::tibble(
Term = rownames(co10),
`Estimate (SE)` = sprintf("%.3f (%.3f)", co10[, "Estimate"], co10[, "Std. Error"])
) |>
dplyr::mutate(
Term = dplyr::case_when(
Term == "edges" ~ "Edges",
Term == "mutual" ~ "Mutual",
Term == "nodematch.gender" ~ "Gender homophily (nodematch)",
grepl("^gwesp", Term) ~ "Transitive closure (GWESP 0.7)",
Term == "twopath" ~ "Two-path",
grepl("^gwideg|^gwidegree", Term) ~ "Preferential attachment (GW indegree 0.7)",
grepl("^edgecov\\.", Term) & grepl("L", Term) ~ "Edgecov: liking nominations",
grepl("^edgecov\\.", Term) & grepl("P", Term) ~ "Edgecov: popularity nominations",
TRUE ~ Term
)
)
knitr::kable(out10, booktabs = TRUE)
#| label: app-fig-gof-like
#| fig-cap: "Appendix. Goodness-of-fit diagnostics for the liking ERGM."
#| echo: false
#| message: false
