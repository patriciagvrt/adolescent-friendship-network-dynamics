# Create data frames for degree distributions
deg_in_df <- data.frame(in_degree = in_deg)
in_deg  <- degree(g, mode = "in")
out_deg <- degree(g, mode = "out")
# Create data frames for degree distributions
deg_in_df <- data.frame(in_degree = in_deg)
deg_out_df <- data.frame(out_degree = out_deg)
# In-degree distribution
ggplot(deg_in_df, aes(x = in_degree)) +
geom_histogram(binwidth = 1, fill = "steelblue", color = "black") +
labs(
title = "In-degree distribution of the advice network",
x = "In-degree",
y = "Number of lawyers"
) +
theme_minimal()
# Out-degree distribution
ggplot(deg_out_df, aes(x = out_degree)) +
geom_histogram(binwidth = 1, fill = "darkorange", color = "black") +
labs(
title = "Out-degree distribution of the advice network",
x = "Out-degree",
y = "Number of lawyers"
) +
theme_minimal()
# Create descriptive statistics for node-level variables
node_descriptives <- data.frame(
Variable = c(
"Gender (mean)",
"Status (mean)",
"Office (mean)",
"Age (mean)",
"Years in firm (mean)"
),
Value = c(
mean(attr$gender),
mean(attr$status),
mean(attr$office),
mean(attr$age),
mean(attr$years_firm)
)
)
knitr::kable(
node_descriptives,
digits = 2,
caption = "Descriptive statistics for node-level attributes in the Lazega Lawyers network"
)
