library(igraph)
library(dplyr)
options(scipen = 999)
# Project folder
knitr::opts_knit$set(root.dir = "~/Lab-assignments---Social-Network-Analysis/LAB 1 SNA")
# Read files (these must be inside the root.dir folder)
net  <- read.table("ELadv.dat", header = FALSE)
attr <- read.table("ELattr.dat", header = FALSE)
# Convert to matrix
net_mtx <- as.matrix(net)
# Add node ids as row and column names (1..N)
node_ids <- 1:nrow(net_mtx)
rownames(net_mtx) <- node_ids
colnames(net_mtx) <- node_ids
# Name the attribute columns (your file has 8 columns)
colnames(attr) <- c(
"id",
"seniority",
"status",
"gender",
"office",
"years_firm",
"age",
"practice"
)
# Create igraph object (directed advice network)
g <- graph_from_adjacency_matrix(net_mtx, mode = "directed", diag = FALSE)
# Attach attributes to the graph (match by id)
attr <- attr %>% arrange(id)
V(g)$id         <- attr$id
V(g)$seniority  <- attr$seniority
V(g)$status     <- attr$status
V(g)$gender     <- attr$gender
V(g)$office     <- attr$office
V(g)$years_firm <- attr$years_firm
V(g)$age        <- attr$age
V(g)$practice   <- attr$practice
dim(net)
dim(attr)
g
vcount(g)
ecount(g)
degree(g, mode = "all")
components(g)
degree(g, mode = "all")
components(g)
density_g <- edge_density(g)
density_g
in_deg  <- degree(g, mode = "in")
out_deg <- degree(g, mode = "out")
mean_in_deg  <- mean(in_deg)
mean_out_deg <- mean(out_deg)
sd_in_deg  <- sd(in_deg)
sd_out_deg <- sd(out_deg)
recip <- reciprocity(g)
recip
trans <- transitivity(g, type = "global")
trans
stats_table <- data.frame(
Measure = c(
"Density",
"Average in-degree",
"Average out-degree",
"SD in-degree",
"SD out-degree",
"Reciprocity",
"Transitivity"
),
Value = c(
density_g,
mean_in_deg,
mean_out_deg,
sd_in_deg,
sd_out_deg,
recip,
trans
)
)
stats_table
